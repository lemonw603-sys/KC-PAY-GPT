NODE_ENV=production
HOST=127.0.0.1
PORT=3100
TRUST_PROXY=false
DATABASE_URL=mysql://user:password@127.0.0.1:3306/pojia
DATABASE_TLS=false
# DATABASE_TLS_CA_BASE64 is required only when the server certificate uses a private CA.
# DATABASE_TLS_CA_BASE64=base64_encoded_pem_ca
MIGRATION_DATABASE_URL=mysql://migrator:password@127.0.0.1:3306/pojia
MIGRATION_DATABASE_TLS=false
# MIGRATION_DATABASE_TLS_CA_BASE64=base64_encoded_pem_ca
SESSION_ENCRYPTION_KEY_BASE64=replace_with_32_random_bytes_in_base64
CDK_HASH_KEY_V1_BASE64=replace_with_a_different_32_random_bytes_in_base64
CDK_RECOVERY_KEY_BASE64=replace_with_another_32_random_bytes_in_base64
ADMIN_HOST=ops.example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET_BASE64=
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_CONCURRENCY=1
PROVIDER_READS_ENABLED=false
PROVIDER_WRITES_ENABLED=false
HNSKJ_API_BASE_URL=https://card.hnskj.vip/api/open/v1
# HNSKJ_API_KEY is injected by the deployment secret store when reads are approved.
ZZSHU_API_BASE_URL=https://card.zzshu.pro/api/v1
# ZZSHU_API_KEY is injected by the deployment secret store when reads are approved.
BARK_ENABLED=false
BARK_SERVER_URL=https://api.day.app
# BARK_DEVICE_KEY is injected by the deployment secret store when Bark is enabled.
BARK_GROUP=AI充值业务
BARK_POLL_INTERVAL_MS=5000
BARK_REQUEST_TIMEOUT_MS=10000
BARK_MAX_ATTEMPTS=8
