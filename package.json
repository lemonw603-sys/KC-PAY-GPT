{
  "name": "kc-gpt-pay",
  "version": "1.0.0",
  "description": "ChatGPT Plus 自动化开通工具（Stripe 信用卡直付）：注册 → Stripe Checkout → 信用卡卡池支付 → 协议 token 入库",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "start": "npm --prefix v1 start",
    "start:legacy": "node server.js",
    "start:legacy:headful": "cross-env HEADFUL=1 node server.js",
    "test": "npm run test:legacy && npm run test:v1",
    "test:legacy": "vitest --run",
    "test:v1": "npm --prefix v1 test",
    "test:watch:legacy": "vitest",
    "poc:browser-session:public": "node browser-poc/session-ab-poc.js --public-control --mode cookie-only",
    "poc:browser-session:summarize": "node browser-poc/summarize-ab.js",
    "poc:browser-session:route-order": "node browser-poc/route-order-proof.js",
    "poc:browser-experiment:offline": "node browser-poc/run-offline-experiment.js",
    "poc:browser-experiment:wal": "node browser-poc/run-offline-wal-recovery.js",
    "poc:browser-experiment:capacity": "node browser-poc/run-capacity-simulation.js 350",
    "test:browser-poc": "vitest --run test/browser-session-ab-poc.test.js test/browser-checkout-link-core.test.js test/browser-experiment-core.test.js test/browser-mock-gateway.test.js test/browser-offline-experiment-runner.test.js test/browser-experiment-wal.test.js test/browser-offline-wal-recovery.test.js test/browser-local-mock-page.test.js test/browser-wal-backed-experiment.test.js test/browser-process-crash-recovery.test.js test/browser-capacity-simulation.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "express": "^4.18.2",
    "fs-extra": "^11.3.4",
    "imapflow": "^1.3.3",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.8",
    "mysql2": "^3.15.2",
    "otplib": "12.0.1",
    "path": "^0.12.7",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "playwright-stealth": "^0.0.1",
    "proxy-agent": "^8.0.1",
    "proxy-chain": "^2.7.1",
    "puppeteer-core": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^14.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "fast-check": "^4.8.0",
    "vitest": "^4.1.9"
  }
}
