# Copy to ~/Library/Application Support/VibeBridge/browser-readonly.env and chmod 0600.
# This template is disabled by default and contains no real credentials.
NODE_ENV=production
DATABASE_URL='mysql://browser_runtime:REPLACE_ME@127.0.0.1:13306/pojia'
DATABASE_TLS=false

BROWSER_WORKER_MODE=PRODUCTION_READONLY
BROWSER_WORKER_CONFIRMATION='RUN BROWSER PRODUCTION READONLY WORKER'
BROWSER_WORKER_TARGET=EXTERNAL_READONLY
BROWSER_EXTERNAL_READONLY_CONFIRM=I-CONFIRM-EXTERNAL-READONLY-SHARED-MATERIALS-NO-PAYMENT
BROWSER_READONLY_HARNESS=CHATGPT_ACCOUNT_CHECKOUT
BROWSER_SHARED_MATERIALS_MODE=SHARED_ENCRYPTED_NONPAYMENT
BROWSER_OBSERVE_URL_PREFIX=https://chatgpt.com/
BROWSER_OBSERVE_TITLE=ChatGPT
BROWSER_OBSERVE_REQUIRED_SELECTOR=body
BROWSER_OBSERVE_MARKER_TEXT=
BROWSER_RUNTIME_PROVIDER=GOOGLE_CHROME
BROWSER_CHROME_EXECUTABLE_PATH='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
BROWSER_CHROME_HEADLESS=false
BROWSER_WORKER_ID=macos-headed-readonly-1
BROWSER_EXECUTOR_PROFILE_ID=REPLACE_WITH_BROWSER_PROFILE_ID
BROWSER_PROFILES_ROOT="$HOME/Library/Application Support/VibeBridge/profiles"
BROWSER_WAL_PATH="$HOME/Library/Application Support/VibeBridge/wal/events.jsonl"
BROWSER_RUNTIME_HMAC_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64
BROWSER_ARTIFACT_KEY_BASE64=REPLACE_WITH_DISTINCT_32_BYTE_BASE64
BROWSER_RESOURCE_HMAC_KEY_BASE64=REPLACE_WITH_DISTINCT_32_BYTE_BASE64
SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_EXISTING_SHARED_KEY
BROWSER_WORKER_POLL_INTERVAL_MS=1000
BROWSER_WORKER_HEARTBEAT_INTERVAL_MS=10000
BROWSER_WORKER_LEASE_SECONDS=60
BROWSER_EXECUTION_TIMEOUT_MS=30000
BROWSER_LOCAL_RUN_MODE=ONCE

BROWSER_DB_TUNNEL_SSH_TARGET=REPLACE_WITH_RESTRICTED_SSH_TARGET
BROWSER_DB_TUNNEL_IDENTITY_FILE="$HOME/.ssh/REPLACE_WITH_RESTRICTED_KEY"
BROWSER_DB_TUNNEL_LOCAL_PORT=13306
BROWSER_DB_TUNNEL_REMOTE_HOST=127.0.0.1
BROWSER_DB_TUNNEL_REMOTE_PORT=3306

BROWSER_PAYMENT_WRITES_ENABLED=false
BROWSER_PAYMENT_EXECUTOR_ENABLED=false
BROWSER_PAYMENT_EXECUTOR_MODE=MOCK
PROVIDER_WRITES_ENABLED=false
PROVIDER_CARD_WRITES_ENABLED=false
PROVIDER_RECHARGE_WRITES_ENABLED=false
CARD_FUNDING_WRITES_ENABLED=false

# BitBrowser alternative (disabled by default). When selected, comment out the
# Chrome executable/profile-root settings above and provide one operator-created
# local test Profile ID. Never put proxy subscription credentials in this file.
# BROWSER_RUNTIME_PROVIDER=BITBROWSER
# BROWSER_BITBROWSER_ENABLED=false
# BROWSER_BITBROWSER_API_URL=http://127.0.0.1:54345
# BROWSER_BITBROWSER_PROFILE_ID=REPLACE_WITH_LOCAL_TEST_PROFILE_ID
# For the six-lane pool, use the list instead of BROWSER_BITBROWSER_PROFILE_ID:
# BROWSER_BITBROWSER_PROFILE_IDS=PROFILE_1,PROFILE_2,PROFILE_3,PROFILE_4,PROFILE_5,PROFILE_6
# BROWSER_BITBROWSER_KEEP_ALIVE=true
# BROWSER_WORKER_CONCURRENCY=6
# BROWSER_BITBROWSER_API_TIMEOUT_MS=10000
