<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vibebridge.browser-readonly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_REPO/browser-mvp/scripts/run-macos-headed-worker.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BROWSER_LOCAL_ENV_FILE</key>
    <string>REPLACE_WITH_HOME/Library/Application Support/VibeBridge/browser-readonly.env</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/VibeBridge/browser-readonly.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/VibeBridge/browser-readonly.error.log</string>
</dict>
</plist>
