[Unit]
Description=AI充值业务卡片余额充值只读对账
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=pojia
Group=pojia
WorkingDirectory=/opt/pojia/current/v1
EnvironmentFile=/etc/pojia/runtime.env
EnvironmentFile=/etc/pojia/provider.env
ExecStart=/usr/bin/env PROVIDER_WRITES_ENABLED=false PROVIDER_RECHARGE_WRITES_ENABLED=false PROVIDER_CARD_WRITES_ENABLED=false /usr/bin/node scripts/card-funding-reconcile-runner.js
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
