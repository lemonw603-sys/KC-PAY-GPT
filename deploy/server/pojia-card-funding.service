[Unit]
Description=AI充值业务卡片余额充值执行器（默认关闭）
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=pojia
Group=pojia
WorkingDirectory=/opt/pojia/current/v1
EnvironmentFile=/etc/pojia/runtime.env
EnvironmentFile=/etc/pojia/provider.env
# The provider capability is intentionally narrow: card balance funding only.
# A second, unit-specific gate remains off after ordinary deployments and is
# enabled with a systemd drop-in only during an approved production rollout.
Environment=CARD_FUNDING_EXECUTION_ENABLED=false
ExecStart=/usr/bin/env PROVIDER_WRITES_ENABLED=false PROVIDER_RECHARGE_WRITES_ENABLED=false PROVIDER_CARD_WRITES_ENABLED=true /usr/bin/node scripts/card-funding-runner.js
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
