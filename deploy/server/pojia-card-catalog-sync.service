[Unit]
Description=破甲卡台库存只读对账
After=network-online.target pojia-worker.service
Wants=network-online.target

[Service]
Type=oneshot
User=pojia
Group=pojia
WorkingDirectory=/opt/pojia/current/v1
EnvironmentFile=/etc/pojia/runtime.env
EnvironmentFile=/etc/pojia/provider.env
ExecStart=/usr/bin/env PROVIDER_WRITES_ENABLED=false PROVIDER_CARD_WRITES_ENABLED=false /usr/bin/node scripts/card-catalog-sync.js
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

