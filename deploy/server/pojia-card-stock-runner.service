[Unit]
Description=破甲库存卡后台任务执行器
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=pojia
Group=pojia
WorkingDirectory=/opt/pojia/current/v1
EnvironmentFile=/etc/pojia/runtime.env
EnvironmentFile=/etc/pojia/provider.env
Environment=PROVIDER_WRITES_ENABLED=false
Environment=PROVIDER_CARD_WRITES_ENABLED=true
ExecStart=/usr/bin/node scripts/card-stock-job-runner.js
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/pojia /tmp
UMask=0077

[Install]
WantedBy=multi-user.target
