[Unit]
Description=AI充值业务 运营巡视告警（排队超时、付款未落定、无可用卡）
After=network-online.target

[Service]
Type=oneshot
User=pojia
WorkingDirectory=/opt/pojia/current/v1
EnvironmentFile=/etc/pojia/runtime.env
ExecStart=/usr/bin/node scripts/operator-watch.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pojia
