<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 常驻 Browser 充值池（D-167 第 2 项）。与既有的 com.pojia.mihomo-ph / com.pojia.ssh-tunnel-13306 同一套做法。
     安装：cp 到 ~/Library/LaunchAgents/ 后 launchctl load -w；停用：launchctl unload -w。
     注意：它会在开机后自动开始接单，付款开关为 true 时即可真实扣款。关掉付款开关即可让它只等不跑。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pojia.browser-pool</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <!-- D-377/D-383：从固定版本目录跑（scripts/pool-release.sh prepare/switch 管 current 软链），
         不再跑 main 工作区——工作区里的改动不会在池子下次重启时悄悄上线。 -->
    <string>/Users/lemon/pojia-pool/current/browser-mvp/scripts/live-pool-supervisor.sh</string>
  </array>
  <!-- launchd 的默认 PATH 只有 /usr/bin:/bin:/usr/sbin:/sbin，取不到 Homebrew 装的 mysql，
       prod-query.sh 就查不出付款开关，supervisor 会永远停在「只等不跑」——开了开关也不动。
       2026-09-12 实测踩到，装上后必须看一眼日志里写的是 false 还是「取不到」。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- D-386：付款后核实器上限 300000 毫秒；run-live-pool.sh 默认的 1800000 会让每张真付款单在填卡前报错。
         这里显式给 300000（run-live-pool.sh 用 ${VAR:-默认}，已有值优先）。代码层上限对齐在批 B。 -->
    <key>BROWSER_PAYMENT_VERIFICATION_WINDOW_MS</key><string>300000</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/lemon/Library/Application Support/pojia-browser-live/supervisor.log</string>
  <key>StandardErrorPath</key><string>/Users/lemon/Library/Application Support/pojia-browser-live/supervisor.log</string>
</dict>
</plist>
