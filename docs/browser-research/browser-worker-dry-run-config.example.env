# Copy to a shell environment or a local, untracked file. Do not put real
# Session, PAN, CVC, provider keys, or production URLs in this template.
# The launcher refuses to run if any required value is missing.

# Use "isolated-fixture" to let the launcher create/delete a temporary local
# MySQL 8.4 and run the complete fixture test without coordinator input.
# Use "isolated" only with a coordinator-supplied TEST_DATABASE_URL.
BROWSER_DRY_RUN_ENV=isolated-fixture
# BROWSER_DRY_RUN_ENV=isolated
# BROWSER_DRY_RUN_ENV=preprod
# BROWSER_DRY_RUN_PREPROD_CONFIRM=I-CONFIRM-NONPAYMENT-PREPROD

# Supplied by the coordinator. It must point to an isolated/preprod MySQL
# database whose migrations 001-037 are already applied. Never guess this URL.
TEST_DATABASE_URL=mysql://<user>:<password>@<isolated-host>:<port>/<database>

# Every write-capable flag must be explicitly false; the launcher rejects
# unset or true values. These are supplied by the coordinator/deployment.
BROWSER_PAYMENT_WRITES_ENABLED=false
PROVIDER_WRITES_ENABLED=false
PROVIDER_CARD_WRITES_ENABLED=false
PROVIDER_RECHARGE_WRITES_ENABLED=false
CARD_FUNDING_WRITES_ENABLED=false

# The following must remain unset. They are listed as a visual guardrail only;
# do not fill them in this file.
# CHATGPT_SESSION_COOKIE=
# CHATGPT_TOKEN=
# SESSION_JSON=
# CARD_NUMBER=
# CARD_EXPIRY=
# CARD_CVC=

# Supplied by the coordinator when testing a real Worker deployment. The
# Browser-only local composition uses its own deterministic worker/fixture
# values, so no worker ID or card/session value belongs in this template.
# BROWSER_WORKER_ID=
# BROWSER_EXECUTOR_PROFILE_ID=
